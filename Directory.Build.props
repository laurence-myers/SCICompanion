<?xml version="1.0" encoding="utf-8"?>
<!-- Solution-wide build settings. -->
<Project>

  <!--
    std::filesystem needs C++17. This code predates C++17, so three MSVC
    switches keep it compiling unchanged:
      _HAS_AUTO_PTR_ETC=1
        Restores adaptors C++17 removed (unary_function, binary_function,
        bind2nd, mem_fun_ref, ptr_fun).
      _HAS_STD_BYTE=0
        Disables std::byte, which is ambiguous with the Windows byte typedef
        in files that have "using namespace std".
      _SILENCE_ALL_CXX17_DEPRECATION_WARNINGS
        Accepts C++17 deprecations such as <codecvt> and std::not1. SDLCheck
        is on, so these would otherwise be errors. The features still work.
      _SILENCE_STDEXT_ARR_ITERS_DEPRECATION_WARNING
        The bundled cppformat (Src\CppFormat\format.h) uses
        stdext::checked_array_iterator, a non-Standard MSVC extension the
        current toolset deprecates (STL4043). Only the Debug config compiles
        that path (its checked iterators are on), so without this the Debug
        build fails under SDLCheck while Release is fine. The extension works.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PreprocessorDefinitions>_HAS_AUTO_PTR_ETC=1;_HAS_STD_BYTE=0;_SILENCE_ALL_CXX17_DEPRECATION_WARNINGS;_SILENCE_STDEXT_ARR_ITERS_DEPRECATION_WARNING;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    A discarded sci::Result or sci::Status (a [[nodiscard]] type) is a build
    error in our projects, so no failure goes unhandled
    (docs/scic-cli/plan.md, section 6). The vendored Prof-UIS keeps its own
    settings.
  -->
  <ItemDefinitionGroup Condition="!$(MSBuildProjectName.StartsWith('ProfUISLIB'))">
    <ClCompile>
      <TreatSpecificWarningsAsErrors>4834;%(TreatSpecificWarningsAsErrors)</TreatSpecificWarningsAsErrors>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    Do not embed the manifest into the exe. Inside a Visual Studio build the
    freshly linked exe is briefly held, so the embed step (mt.exe) fails with
    LNK1327. A side-by-side SCICompanion.exe.manifest avoids that. Windows reads
    it next to the exe, so Common-Controls v6 theming still works.
  -->
  <PropertyGroup>
    <EmbedManifest>false</EmbedManifest>
  </PropertyGroup>

  <!--
    vcpkg gives the header-only libraries in vcpkg.json (manifest mode). The
    vcpkg folder: the VCPKG_ROOT environment variable, else
    VCPKG_INSTALLATION_ROOT (the GitHub runners), else the copy that the
    Visual Studio component "vcpkg package manager" installs. The packages
    go into vcpkg_installed\, which git ignores. Only SCICompanionCore runs
    vcpkg install; the other projects build after it and read the same
    folder. A change of vcpkg.json rebuilds the projects (see
    Directory.Build.targets).
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.StartsWith('ProfUISLIB'))">
    <ScicVcpkgRoot Condition="'$(VCPKG_ROOT)' != ''">$(VCPKG_ROOT)</ScicVcpkgRoot>
    <ScicVcpkgRoot Condition="'$(ScicVcpkgRoot)' == '' and '$(VCPKG_INSTALLATION_ROOT)' != ''">$(VCPKG_INSTALLATION_ROOT)</ScicVcpkgRoot>
    <ScicVcpkgRoot Condition="'$(ScicVcpkgRoot)' == ''">$(VsInstallRoot)\VC\vcpkg</ScicVcpkgRoot>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestInstall Condition="'$(MSBuildProjectName)' != 'SCICompanionCore'">false</VcpkgManifestInstall>
  </PropertyGroup>
  <Import Condition="!$(MSBuildProjectName.StartsWith('ProfUISLIB')) and Exists('$(ScicVcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.props')"
          Project="$(ScicVcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.props" />

</Project>
