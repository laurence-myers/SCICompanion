<?xml version="1.0" encoding="utf-8"?>
<!-- Solution-wide build settings. -->
<Project>

  <!--
    std::filesystem needs C++17. This code predates C++17, so three MSVC
    switches keep it compiling unchanged:
      _HAS_AUTO_PTR_ETC=1
        Restores adaptors C++17 removed (unary_function, binary_function,
        bind2nd, mem_fun_ref, ptr_fun).
      _HAS_STD_BYTE=0
        Disables std::byte, which is ambiguous with the Windows byte typedef
        in files that have "using namespace std".
      _SILENCE_ALL_CXX17_DEPRECATION_WARNINGS
        Accepts C++17 deprecations such as <codecvt> and std::not1. SDLCheck
        is on, so these would otherwise be errors. The features still work.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PreprocessorDefinitions>_HAS_AUTO_PTR_ETC=1;_HAS_STD_BYTE=0;_SILENCE_ALL_CXX17_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    Do not embed the manifest into the exe. Inside a Visual Studio build the
    freshly linked exe is briefly held, so the embed step (mt.exe) fails with
    LNK1327. A side-by-side SCICompanion.exe.manifest avoids that. Windows reads
    it next to the exe, so Common-Controls v6 theming still works.
  -->
  <PropertyGroup>
    <EmbedManifest>false</EmbedManifest>
  </PropertyGroup>

</Project>
