<?xml version="1.0" encoding="utf-8"?>
<!--
  Solution-wide build tweaks for building this v140-era code with the v141
  (VS2017) toolset plus a modern Windows SDK. Delete this file to revert.
-->
<Project>

  <!--
    std::tr2::sys (old experimental filesystem) is deprecated on v141. Every
    project here builds with SDLCheck on, so that deprecation (C4996) becomes a
    build error. This macro acknowledges it. The namespace still works on v141.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_SILENCE_TR2_SYS_NAMESPACE_DEPRECATION_WARNING;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    LNK1327 (failure during running mt.exe) when linking the exe inside Visual
    Studio. With the default settings the linker writes the exe and then calls
    mt.exe to embed the manifest back into that same exe. Inside the VS build
    something briefly holds the freshly written exe, so the embed step fails.
    The command-line build does not hit this. Setting EmbedManifest to false
    makes the build write a side-by-side SCICompanion.exe.manifest instead, so
    the exe is never reopened. The Common-Controls v6 theming still works,
    because Windows reads the .manifest file next to the exe.

    To keep the manifest embedded inside the exe instead, remove this property,
    add  1 24 "res\SCICompanion.manifest"  to SCICompanion.rc, and set
    GenerateManifest to false. That avoids mt.exe as well.
  -->
  <PropertyGroup>
    <EmbedManifest>false</EmbedManifest>
  </PropertyGroup>

</Project>
